# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env - it is listed in .gitignore.

# Get a free key at https://console.groq.com/keys (leave empty to run without the AI tutor)
GROQ_API_KEY=your_groq_api_key_here

# Any chat model available to your Groq account
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of websites allowed to call this API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tutor requests allowed per visitor per minute
RATE_LIMIT_PER_MINUTE=20
